---
/** Switches between the light and dark themes and remembers the choice. */
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch between light and dark theme"
  class="border-line text-muted hover:text-ink hover:border-ink grid size-9 place-items-center rounded-full border transition-colors"
>
  <svg
    viewBox="0 0 24 24"
    class="size-4"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      stroke-linecap="round"
      d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4"
    ></path>
  </svg>
</button>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target?.closest('[data-theme-toggle]')) return;

    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
  });
</script>
