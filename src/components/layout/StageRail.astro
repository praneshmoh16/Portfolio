---
/**
 * The pipeline line fixed to the left edge on wide screens. It fills as the
 * page scrolls and marks which stage (section) is running.
 */
import { stages } from '@/data/sections';
---

<nav
  aria-label="Page sections"
  data-rail
  class="fixed top-1/2 left-6 z-30 hidden -translate-y-1/2 2xl:block"
>
  <div class="relative">
    <div class="bg-line absolute top-2 bottom-2 left-[5px] w-px"></div>
    <div
      data-rail-fill
      class="bg-target absolute top-2 bottom-2 left-[5px] w-px origin-top scale-y-0"
    ></div>
    <ol class="relative flex flex-col gap-5">
      {stages.map((s) => (
        <li>
          <a
            href={`#${s.id}`}
            data-rail-link={s.id}
            class="group text-muted hover:text-ink flex items-center gap-3 font-mono text-[11px] tracking-wider uppercase"
          >
            <span class="border-line bg-bg group-data-[active]:border-target group-data-[active]:bg-target size-[11px] rounded-full border transition-colors" />
            <span class="group-data-[active]:text-ink opacity-60 transition-opacity group-hover:opacity-100 group-data-[active]:opacity-100">
              {s.stage}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>
