---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import { siteConfig } from '@/config/site';
---

<header class="bg-bg/80 border-line sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="font-mono text-sm font-medium">
      pranesh<span class="text-target">.</span>mohanraj
    </a>
    <div class="flex items-center gap-5">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex gap-5">
          {siteConfig.nav.map((link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-ink text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
