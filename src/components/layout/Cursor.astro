---
/** Custom cursor: a dot and a trailing ring. Enabled by scripts/cursor.ts. */
---

<div
  data-cursor-ring
  aria-hidden="true"
  class="border-target pointer-events-none fixed top-0 left-0 z-50 hidden size-9 -translate-x-1/2 -translate-y-1/2 rounded-full border opacity-70"
></div>
<div
  data-cursor-dot
  aria-hidden="true"
  class="bg-target pointer-events-none fixed top-0 left-0 z-50 hidden size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full"
></div>
