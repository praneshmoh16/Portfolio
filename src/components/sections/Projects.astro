---
import { getCollection } from 'astro:content';
import SectionShell from '@/components/ui/SectionShell.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import Tag from '@/components/ui/Tag.astro';
import Route from '@/components/ui/Route.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.find((p) => p.data.featured);
const rest = projects.filter((p) => p !== featured);

const factoryStages = [
  ['discover', 'parse legacy code, map lineage'],
  ['design', 'layers and data contracts'],
  ['generate', 'an LLM writes the PySpark'],
  ['reconcile', 'diff against legacy output'],
  ['review', 'a human approves'],
];
---

<SectionShell
  id="projects"
  intro="Most of my work moves data from one system to another and proves it arrived intact. Lately, AI agents do part of the moving."
>
  {featured && (
    <article
      data-reveal
      data-tilt
      class="spotlight border-line bg-surface mb-5 grid overflow-hidden rounded-xl border lg:grid-cols-[1.25fr_1fr]"
    >
      <div class="flex min-w-0 flex-col gap-4 p-6 md:p-8">
        <span class="label">{featured.data.context}</span>
        <Route from={featured.data.from} to={featured.data.to} />
        <h3 class="text-2xl font-bold md:text-3xl">{featured.data.title}</h3>
        <p class="text-muted leading-relaxed">{featured.data.summary}</p>
        <div class="flex flex-wrap gap-1.5">
          {featured.data.tags.map((tag) => (
            <Tag>{tag}</Tag>
          ))}
        </div>
      </div>
      <div class="border-line bg-bg min-w-0 border-t p-6 font-mono text-[13px] md:p-8 lg:border-t-0 lg:border-l">
        <p class="label mb-4">agent pipeline</p>
        <ol class="flex flex-col gap-3">
          {factoryStages.map(([name, what], i) => (
            <li class="grid grid-cols-[1.25rem_1fr] gap-2">
              <span class="text-muted">{i + 1}</span>
              <span>
                {name}
                <span class="text-muted block text-xs">{what}</span>
              </span>
            </li>
          ))}
        </ol>
        <p class="border-line mt-5 border-t border-dashed pt-4">
          <span class="bg-target-soft text-target rounded px-2 py-0.5 font-medium">
            ✓ {featured.data.result}
          </span>
        </p>
      </div>
    </article>
  )}
  <div class="grid gap-5 md:grid-cols-2">
    {rest.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</SectionShell>
