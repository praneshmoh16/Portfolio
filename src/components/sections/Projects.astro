---
import { getCollection } from 'astro:content';
import SectionShell from '@/components/ui/SectionShell.astro';
import SkipLink from '@/components/ui/SkipLink.astro';
import ProjectSlide from '@/components/ui/ProjectSlide.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<SectionShell
  id="projects"
  scene="pin"
  intro="Most of my work moves data from one system to another and proves it arrived intact. Lately, AI agents do part of the moving."
>
  <Fragment slot="meta">
    <span class="text-muted cine:inline hidden font-mono text-xs tabular-nums">
      project{' '}
      <span class="text-ink" data-project-count>
        01
      </span>{' '}
      / {pad(projects.length)}
    </span>
    <SkipLink href="#experience" label="skip to experience" />
  </Fragment>
  <div data-project-stage class="cine:block cine:h-full flex flex-col gap-5">
    {projects.map((project, index) => (
      <ProjectSlide project={project} index={index} total={projects.length} />
    ))}
  </div>
</SectionShell>
