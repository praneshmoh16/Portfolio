---
import SectionShell from '@/components/ui/SectionShell.astro';
import { education } from '@/data/education';
---

<SectionShell id="education">
  <ul class="flex flex-col">
    {education.map((item) => (
      <li
        data-reveal
        class="border-line grid gap-2 border-b py-6 first:pt-0 last:border-b-0 md:grid-cols-[220px_1fr] md:gap-10"
      >
        <p class="text-muted font-mono text-xs tabular-nums md:pt-1.5">{item.dates}</p>
        <div class="min-w-0">
          <h3 class="text-xl font-bold">{item.degree}</h3>
          <p class="mt-1">
            {item.school}
            <span class="text-muted"> · {item.place}</span>
          </p>
          <p class="text-muted mt-1 text-sm">{item.note}</p>
        </div>
      </li>
    ))}
  </ul>
</SectionShell>
