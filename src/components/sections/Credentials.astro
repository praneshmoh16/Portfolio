---
import SectionShell from '@/components/ui/SectionShell.astro';
import { certifications, awards } from '@/data/credentials';
---

<SectionShell id="credentials" scene="rise">
  <div class="grid gap-10 md:grid-cols-2">
    <div class="min-w-0">
      <p class="label mb-4">Certifications</p>
      <ul class="flex flex-col gap-3">
        {certifications.map((cert) => (
          <li
            data-reveal
            data-tilt
            class="spotlight border-line bg-surface flex items-start gap-3 rounded-lg border p-4"
          >
            <span class="bg-target-soft text-target grid size-8 shrink-0 place-items-center rounded-full font-mono text-sm">
              ✓
            </span>
            <div class="min-w-0">
              <h3 class="font-sans text-base font-semibold">{cert.name}</h3>
              <p class="text-muted text-sm">
                {cert.issuer}
                {cert.code && <span class="font-mono"> · {cert.code}</span>}
              </p>
              {cert.verifyUrl && (
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-target text-sm underline underline-offset-4"
                >
                  Verify
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
    <div class="min-w-0">
      <p class="label mb-4">Awards</p>
      <ul class="flex flex-col gap-3">
        {awards.map((award) => (
          <li data-reveal data-tilt class="spotlight border-line bg-surface rounded-lg border p-4">
            <p class="text-source font-mono text-xs">
              {award.issuer} · {award.when}
            </p>
            <h3 class="mt-1 font-sans text-base font-semibold">{award.name}</h3>
            <p class="text-muted mt-1 text-sm">{award.reason}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</SectionShell>
