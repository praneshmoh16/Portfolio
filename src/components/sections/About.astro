---
import SectionShell from '@/components/ui/SectionShell.astro';
import { about } from '@/data/about';
import { siteConfig } from '@/config/site';

const initials = siteConfig.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<SectionShell id="about" scene="rise">
  <div class="grid gap-10 md:grid-cols-[240px_1fr] md:gap-14">
    <div data-reveal class="min-w-0">
      {about.photo ? (
        <img
          src={about.photo}
          alt={`Portrait of ${siteConfig.name}`}
          class="border-line aspect-[4/5] w-full max-w-[240px] rounded-xl border object-cover"
        />
      ) : (
        <div
          class="border-line bg-surface font-display text-muted grid aspect-[4/5] w-full max-w-[240px] place-items-center rounded-xl border text-5xl font-bold"
          aria-hidden="true"
        >
          {initials}
        </div>
      )}
    </div>
    <div class="flex min-w-0 flex-col gap-5">
      <p class="font-display text-2xl leading-snug font-medium md:text-3xl" data-reveal>
        {about.lead}
      </p>
      {about.paragraphs.map((text) => (
        <p class="text-muted max-w-2xl text-lg leading-relaxed" data-reveal>
          {text}
        </p>
      ))}
      <p
        class="border-target bg-target-soft/60 max-w-2xl rounded-r-lg border-l-2 py-3 pr-4 pl-4 text-lg"
        data-reveal
      >
        {about.lookingFor}
      </p>
    </div>
  </div>
</SectionShell>
