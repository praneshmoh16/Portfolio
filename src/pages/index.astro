---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
---

<BaseLayout>
  <section class="py-24">
    <p class="text-muted text-sm tracking-widest uppercase">{siteConfig.role}</p>
    <h1 class="mt-3 text-5xl font-bold tracking-tight">{siteConfig.name}</h1>
    <p class="text-muted mt-4 max-w-prose">Site under construction. Content is on its way.</p>
  </section>
</BaseLayout>
